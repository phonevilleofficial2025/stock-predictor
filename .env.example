
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

POSTGRES_USER=stockuser
POSTGRES_PASSWORD=change_me
POSTGRES_DB=stockdb

# Cloudflare Turnstile — leave both blank to disable the human-verification gate
# (e.g. local dev). Site key is public (safe to ship to the browser, baked in at
# client build time); secret key is server-only, never expose it.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Sentry — leave blank to disable (local dev). Two separate projects/DSNs: one for
# the Express server, one for the React client. DSNs are public identifiers, not
# secrets, but still only needed where each SDK actually runs.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=1.0
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=1.0
